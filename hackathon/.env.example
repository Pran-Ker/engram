# Copy to .env or export in your shell. Real values live in ~/.local/secrets, never in git.
NIMBLE_API_KEY=            # https://online.nimbleway.com/account-settings/api-keys
BFL_API_KEY=               # https://dashboard.bfl.ai → project → API → Keys
RAWTREE_API_KEY=           # https://rawtree.com/tokensand → cluster → API keys (starts rt_)
RAWTREE_ORG=tokensand
RAWTREE_CLUSTER=long-horizon-agents-hack
RAWTREE_DATABASE=default   # shared cluster: prefix our tables with lh_
LIQUID_MODEL=hf.co/LiquidAI/LFM2.5-1.2B-Instruct-GGUF:Q4_K_M   # any Ollama model tag
